      "types": "./src/lib/fingerprint.ts",
      "import": "./src/lib/fingerprint.ts",
      "default": "./src/lib/fingerprint.ts"
    },
    "./lib/pdf": {
      "types": "./src/lib/pdf.ts",
      "import": "./src/lib/pdf.ts",
      "default": "./src/lib/pdf.ts"
    },
    "./api/health": {
      "types": "./src/api/health.ts",
      "import": "./src/api/health.ts",
      "default": "./src/api/health.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@pdf-lib/fontkit": "^1.1",
