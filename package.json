    "@types/react-dom": "^19.2.5",
    "googleapis": "^176.0.0",
    "next": "^16.3.3",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^4.8.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "peerDependenciesMeta": {
    "googleapis": {
      "optional": true
    },
    "resend": {
      "optional": true
    },
    "pdf-lib": {
